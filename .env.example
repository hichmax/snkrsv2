# Database / Neon - SECRET
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Admin - SECRET
ADMIN_PASSWORD=""
ADMIN_SESSION_SALT=""

# Cloudinary - server-side configuration; API_SECRET is the sensitive value.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional manual quota shown in Admin when the Cloudinary Usage API is unavailable.
CLOUDINARY_STORAGE_LIMIT_BYTES=""

# Cloudflare R2 - server-side configuration; SECRET_ACCESS_KEY is sensitive.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Optional legacy alias supported by the code. Prefer R2_BUCKET.
R2_BUCKET_NAME=""
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
# Public read URL: custom domain recommended, or an r2.dev URL.
R2_PUBLIC_BASE_URL=""
R2_STORAGE_LIMIT_BYTES=""

# Supabase Storage
# SUPABASE_URL is not secret but remains server-side here. SERVICE_ROLE_KEY is secret.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="catalog"
# These two values are intentionally public and used only for signed browser uploads.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_STORAGE_LIMIT_BYTES=""

# Order notifications - SECRET except the sender/recipient addresses.
RESEND_API_KEY=""
ORDER_NOTIFICATION_EMAIL=""
ORDER_FROM_EMAIL="SNKRS <onboarding@resend.dev>"
